{
  "name": "smk-doc-platform",
  "version": "2.0.0",
  "private": true,
  "description": "SMK Document Generation Platform v2 — Monorepo",
  "scripts": {
    "dev": "npm --prefix frontend-v2 run dev",
    "dev:backend": "dotnet run --project backend-v2/src/SmkDoc.Api/SmkDoc.Api.csproj",
    "dev:worker": "dotnet run --project backend-v2/src/SmkDoc.Worker/SmkDoc.Worker.csproj",
    "build": "npm --prefix frontend-v2 run build && dotnet build backend-v2/SmkDocServerV2.slnx -c Release",
    "build:frontend": "npm --prefix frontend-v2 run build",
    "build:backend": "dotnet build backend-v2/SmkDocServerV2.slnx -c Release",
    "lint": "npm --prefix frontend-v2 run lint -- --max-warnings=0",
    "typecheck:frontend": "npm --prefix frontend-v2 run typecheck",
    "codegen:frontend": "npm --prefix frontend-v2 run codegen",
    "codegen:check": "npm --prefix frontend-v2 run codegen:check",
    "test:frontend": "npm --prefix frontend-v2 test",
    "test:backend": "dotnet test backend-v2/tests/SmkDoc.Tests/SmkDoc.Tests.csproj -c Release",
    "test:arch": "dotnet test backend-v2/tests/SmkDoc.Tests/SmkDoc.Tests.csproj -c Release --filter FullyQualifiedName~Architecture",
    "format:check": "dotnet format backend-v2/SmkDocServerV2.slnx --verify-no-changes --no-restore",
    "format:style": "dotnet format style backend-v2/SmkDocServerV2.slnx --verify-no-changes --no-restore",
    "format:analyzers": "dotnet format analyzers backend-v2/SmkDocServerV2.slnx --verify-no-changes --no-restore",
    "specs:check": "node tools/ci/run-ps.mjs tools/ci/check-specs.ps1",
    "openapi:check": "node tools/ci/run-ps.mjs tools/openapi/check-openapi.ps1",
    "prepare:hooks": "git config core.hooksPath .githooks",
    "docker:config": "docker compose -f docker-compose.v2.yml config -q",
    "docker:up": "docker compose -f docker-compose.v2.yml -p smk-v2 up -d",
    "docker:down": "docker compose -f docker-compose.v2.yml -p smk-v2 down",
    "docker:build": "docker compose -f docker-compose.v2.yml -p smk-v2 up -d --build",
    "docker:logs": "docker compose -f docker-compose.v2.yml -p smk-v2 logs -f"
  }
}
