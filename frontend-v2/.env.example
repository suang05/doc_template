NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_API_KEY=dev-smk-key-2026

# Server-only — used by the Next.js proxy route to reach the backend directly.
# In docker-compose this should be the internal service DNS name (see docker-compose.v2.yml).
API_INTERNAL_URL=http://localhost:8080

# Auth.js — generate with `npx auth secret` (or `openssl rand -base64 32`)
AUTH_SECRET=
