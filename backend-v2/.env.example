# ------------------------------------------------------------------------------
# SMK Document Generation Platform v2 — Environment Variables
# ------------------------------------------------------------------------------

# 1. การกำหนด IP และพอร์ต (IP & Port Mapping)
PORTAL_PORT=3001
DOC_SERVER_PORT=8080
POSTGRES_PORT=5433
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
GOTENBERG_PORT=3000

# 2. ความปลอดภัยและ Master API Key
MASTER_API_KEY=secret-smk-key-2026
ASPNETCORE_ENVIRONMENT=Development

# 3. ฐานข้อมูล PostgreSQL
POSTGRES_DB=smkdoc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=smkdoc;Username=postgres;Password=password

# 4. MinIO S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# 5. Gotenberg PDF Engine
GOTENBERG_URL=http://localhost:3000
