# ------------------------------------------------------------------------------
# SMK Document Generation Platform v2 — Environment Variables
# ------------------------------------------------------------------------------

# 1. การกำหนด IP และพอร์ต (IP & Port Mapping)
PORTAL_PORT=3001
DOC_SERVER_PORT=8080
POSTGRES_PORT=5433
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
GOTENBERG_PORT=3000

# 2. ความปลอดภัยและ Master API Key (รูปแบบ smk_live_{12-char-id}_{secret} หรือเว้นว่างใน Development เพื่อ auto-mint)
MASTER_API_KEY=
ASPNETCORE_ENVIRONMENT=Development
Security__ApiKeyPepper=smk-doc-server-development-api-key-pepper-min-32-chars-2026!
Security__AllowLegacySha256Keys=false
Security__WebhookSigningSecret=smk-doc-server-development-webhook-secret-min-32-chars-2026!

# 3. ฐานข้อมูล PostgreSQL (Dual-role RLS: Migrator owns schema, smk_app runs NOBYPASSRLS)
POSTGRES_DB=smkdoc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
SMK_APP_DB_USER=smk_app
SMK_APP_DB_PASSWORD=smk_app_dev_password_change_me
ConnectionStrings__MigratorConnection=Host=localhost;Port=5433;Database=smkdoc;Username=postgres;Password=password
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=smkdoc;Username=smk_app;Password=smk_app_dev_password_change_me

# 4. MinIO S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# 5. Gotenberg PDF Engine & Background Worker Topology
GOTENBERG_URL=http://localhost:3000
Gotenberg__MaxConcurrentRenders=4
Worker__RunInApiHost=true
