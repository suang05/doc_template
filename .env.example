# ==============================================================================
# SMK Document Generation Platform v2 — Docker Compose & Production Environment
# Usage: copy to `.env` for `docker compose -f docker-compose.v2.yml -p smk-v2 up -d`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ports & Environment Mode
# ------------------------------------------------------------------------------
PORTAL_PORT=3001
DOC_SERVER_PORT=8080
POSTGRES_PORT=5433
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
ASPNETCORE_ENVIRONMENT=Production
GOTENBERG_MAX_CONCURRENTRENDERS=4

# ------------------------------------------------------------------------------
# 2. PostgreSQL 17 (Dual-Role RLS: postgres Migrator + smk_app NOBYPASSRLS)
# ------------------------------------------------------------------------------
POSTGRES_DB=smkdoc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
SMK_APP_DB_USER=smk_app
SMK_APP_DB_PASSWORD=change-me-smk-app-password

# ------------------------------------------------------------------------------
# 3. MinIO S3 Object Storage
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ------------------------------------------------------------------------------
# 4. Security, Cryptography & Initial SuperAdmin Bootstrap
# Generate strong random values (>= 32 chars) before deploying to Production!
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=change-me-32-byte-aes-encryption-key!!
API_KEY_PEPPER=change-me-api-key-hmac-pepper-min-32-chars!!
ALLOW_LEGACY_SHA256_KEYS=false
WEBHOOK_SIGNING_SECRET=change-me-webhook-hmac-secret-min-32-chars!!
JWT_SECRET=change-me-jwt-signing-secret-min-32-chars!!
JWT_ISSUER=SmkDoc
JWT_AUDIENCE=SmkDoc.Portal

# Structured M2M Master Key: smk_live_{12-char-alnum}_{16..128-char-alnum}
MASTER_API_KEY=smk_live_DevMaster01_DevMasterSecretToken1234567890
ADMIN_EMAIL=admin@sammakorn.co.th
ADMIN_PASSWORD=ChangeMe@Admin2026!

# ------------------------------------------------------------------------------
# 5. Frontend Portal v2 (Next.js 15 BFF + Auth.js v5)
# Generate AUTH_SECRET with `npx auth secret` or `openssl rand -base64 32`
# ------------------------------------------------------------------------------
AUTH_SECRET=change-me-authjs-secret-min-32-chars!!
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
