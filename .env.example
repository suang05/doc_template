# ==============================================================================
# SMK Document Generation Platform — Coolify & Docker Environment Variables
# รูปแบบ B: แยก Service ชัดเจน (doc-server: พอร์ต 8080, portal: พอร์ต 3001)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. การกำหนดพอร์ต (Port Mapping)
# ------------------------------------------------------------------------------
# พอร์ตหน้าเว็บ Portal (Next.js Standalone Container)
PORTAL_PORT=3001

# พอร์ต .NET 10 Backend Web API
DOC_SERVER_PORT=8080

# พอร์ตสำหรับ OnlyOffice Document Server (เปิดผ่านเบราว์เซอร์เพื่อแก้ไฟล์แม่แบบ)
ONLYOFFICE_PORT=8082

# พอร์ตฐานข้อมูล PostgreSQL
POSTGRES_PORT=5433

# พอร์ต MinIO Object Storage (S3 API และ Web Console)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# พอร์ต Gotenberg PDF Engine
GOTENBERG_PORT=3000

# ------------------------------------------------------------------------------
# 2. ฐานข้อมูล PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=smkdoc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=smk_doc_db_secret_2026

# ------------------------------------------------------------------------------
# 3. MinIO S3 Object Storage
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=smk_minio_secret_2026

# ------------------------------------------------------------------------------
# 4. ความปลอดภัยและ Master API Key (กุญแจหลัก)
# ------------------------------------------------------------------------------
MASTER_API_KEY=secret-smk-key-2026
ASPNETCORE_ENVIRONMENT=Production

# ------------------------------------------------------------------------------
# 5. โดเมนภายนอก (สำหรับตั้งค่า Reverse Proxy / Domain ใน Coolify)
# ------------------------------------------------------------------------------
# โดเมนของ Backend API (ที่ Portal จะส่ง request ไปหา)
# เช่น https://api-doc.sammakorn.co.th
NEXT_PUBLIC_API_URL=

# โดเมนของ OnlyOffice หากต้องการเข้าถึงจากภายนอก
# เช่น https://office.sammakorn.co.th
NEXT_PUBLIC_ONLYOFFICE_URL=
